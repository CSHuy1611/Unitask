{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "Url": "https://unitaskapp.id.vn"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=UniTaskDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Cloudinary": {
    "CloudName": "your-cloudinary-cloud-name",
    "ApiKey": "your-cloudinary-api-key",
    "ApiSecret": "your-cloudinary-api-secret"
  },
  "Jwt": {
    "Key": "your-jwt-key-minimum-16-characters-long",
    "Issuer": "UniTaskApi",
    "Audience": "UniTaskClient",
    "DurationInMinutes": 1440
  },
  "PayOS": {
    "ClientId": "your-payos-client-id",
    "ApiKey": "your-payos-api-key",
    "ChecksumKey": "your-payos-checksum-key"
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-gmail@gmail.com",
    "Password": "your-app-password",
    "SenderName": "UniTask Notification",
    "SenderEmail": "no-reply@unitask.vn",
    "EnableSsl": true,
    "UseConsoleFallback": true
  }
}