# ==========================================
# UniTask Docker Environment Variables Example
# Sao chép file này thành '.env' và cập nhật các giá trị cấu hình thực tế.
# ==========================================

# 1. SQL Server Configuration
MSSQL_SA_PASSWORD=Your_Key # Mật khẩu tài khoản SA tối thiểu 8 kí tự có hoa, thường, số, đặc biệt

# 2. JWT Config
JWT_KEY=Your_Key # Key bảo mật JWT
JWT_ISSUER=Your_Key
JWT_AUDIENCE=Your_Key

# 3. Cloudinary Config (Xác thực hình ảnh / eKYC / CV)
CLOUDINARY_CLOUD_NAME=Your_Key
CLOUDINARY_API_KEY=Your_Key
CLOUDINARY_API_SECRET=Your_Key

# 4. PayOS API Config (Nạp tiền / Thanh toán)
PAYOS_CLIENT_ID=Your_Key
PAYOS_API_KEY=Your_Key
PAYOS_CHECKSUM_KEY=Your_Key

# 5. Frontend Url Config
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080


